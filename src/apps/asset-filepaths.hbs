<div class="asset-auditor-body">
    <section class="asset-toolbar">
        <div class="asset-toolbar-top">
            <p class="hint">{{localize "asset-auditor.app.overview-hint"}}</p>
            <button type="button" class="recheck-assets-button" title="{{localize 'asset-auditor.app.recheck-hint'}}">
                <i class="fas fa-rotate" aria-hidden="true"></i> {{localize "asset-auditor.app.recheck"}}
            </button>
        </div>
        <div class="asset-scan-status" role="status" aria-live="polite" aria-atomic="true">
            <div class="asset-scan-label"><i class="fas fa-spinner" aria-hidden="true"></i>
                <span class="asset-scan-message">{{scanMessage}}</span>
            </div>
            <progress max="1" aria-label="{{localize 'asset-auditor.app.scan-progress'}}" hidden></progress>
        </div>
        <fieldset>
            <legend>{{localize "asset-auditor.app.search-replace"}}</legend>
            <div class="asset-search-grid">
                <div class="asset-input-group">
                    <label for="asset-auditor-search">{{localize "asset-auditor.app.search-label"}}</label>
                    <span class="asset-input-controls">
                        <input type="text" id="asset-auditor-search" class="search-input" value="{{currentSearchInput}}" placeholder="{{localize 'asset-auditor.app.search-placeholder'}}" />
                        <button type="button" class="delete-search-button icon" title="{{localize 'asset-auditor.app.delete-search-button'}}" aria-label="{{localize 'asset-auditor.app.delete-search-button'}}"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        <button type="button" class="search-button icon" title="{{localize 'asset-auditor.app.search-search-button'}}" aria-label="{{localize 'asset-auditor.app.search-search-button'}}"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></button>
                    </span>
                </div>
                <div class="asset-input-group">
                    <label for="asset-auditor-replace">{{localize "asset-auditor.app.replace-label"}}</label>
                    <span class="asset-input-controls">
                        <input type="text" id="asset-auditor-replace" class="replace-input" value="{{replaceText}}" />
                        <button type="button" class="delete-replace-button icon" title="{{localize 'asset-auditor.app.delete-replace-button'}}" aria-label="{{localize 'asset-auditor.app.delete-replace-button'}}"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        <button type="button" class="replace-button" title="{{localize 'asset-auditor.app.replace-button'}}"><i class="fas fa-arrows-rotate" aria-hidden="true"></i> {{localize "asset-auditor.app.replace-button"}}</button>
                    </span>
                </div>
            </div>
        </fieldset>
        <div class="asset-filters">
            <label class="asset-type-filter">
                <span>{{localize "asset-auditor.app.filter-assets"}}</span>
                <select class="asset-type-dropdown">
                    <option value="">{{localize "asset-auditor.app.all-types"}}</option>
                    {{#each assetTypes}}
                    <option value="{{this}}" {{#if (eq this ../singularType)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </label>
            <label class="asset-invalid-filter"><input type="checkbox" class="toggle-invalid" {{#if showInvalidOnly}}checked{{/if}} /> {{localize "asset-auditor.app.invalid-only"}}</label>
        </div>
    </section>
    <section class="asset-results scrollable">
        {{#if scanCompleted}}{{#unless hasResults}}
        <p class="asset-empty-state">{{localize "asset-auditor.app.scan-empty"}}</p>
        {{/unless}}{{/if}}
            {{#each assets as |group|}}
            {{#if group.assets.length}}
            <h2>{{group.type}}</h2>
            {{#each group.pathGroups as |pathGroup|}}
            <details class="asset-path-group" data-count-key="{{pathGroup.countKey}}" {{#unless pathGroup.isMultiple}}open{{/unless}}>
                <summary>
                    <span class="asset-group-count">{{localize pathGroup.countKey count=pathGroup.count}}</span>
                    — {{pathGroup.path}}
                </summary>
            {{#each pathGroup.assets as |asset|}}
            <div class="asset-row {{#unless asset.isValid}}is-invalid{{/unless}}">
                <i class="asset-status {{asset.icon}}"></i>
                <button type="button" class="open-original-button icon" data-open-key="{{asset.openKey}}"
                    title="{{localize 'asset-auditor.app.open-original'}}"
                    aria-label="{{localize 'asset-auditor.app.open-original'}}: {{asset.name}}">
                    <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                </button>
                <span class="asset-identity">
                    {{asset.name}}
                    {{#if asset.contextLabel}}
                    <small class="asset-context">{{asset.contextLabel}}</small>
                    {{/if}}
                    {{#if asset.isWildcard}}
                    <small class="asset-wildcard-info"
                        title="{{localize 'asset-auditor.app.wildcard-picker-warning'}}">
                        {{localize "asset-auditor.app.wildcard-count" count=asset.wildcardCount}}
                    </small>
                    {{/if}}
                </span>
                <input type="text" value="{{asset.path}}" data-original-value="{{asset.path}}" class="path-input" aria-label="{{localize 'asset-auditor.app.path-label'}}: {{asset.name}}" />
                <button type="button" class="reset-button icon" aria-label="{{localize 'asset-auditor.app.reset-button'}}" title="{{localize "asset-auditor.app.reset-button" }}"
                    data-asset-key="{{asset.openKey}}"
                    disabled>
                    <i class="fa fa-undo"></i>
                </button>
                <button type="button" class="browse-button icon" aria-label="{{localize 'asset-auditor.app.browse-button'}}" title="{{localize "asset-auditor.app.browse-button" }}"
                    data-asset-key="{{asset.openKey}}">
                    <i class="fa fa-folder-open"></i>
                </button>
                <button type="button" class="update-button icon" aria-label="{{localize 'asset-auditor.app.update-button'}}" title="{{localize "asset-auditor.app.update-button" }}"
                    data-asset-key="{{asset.openKey}}"
                    disabled>
                    <i class="fa fa-save"></i>
                </button>
            </div>
            {{#unless asset.isValid}}
            <div class="asset-invalid-hint">
                <span>{{localize
                    "asset-auditor.app.last-valid-path"}}</span>
                <span>{{asset.lastValidPath}}</span>
            </div>
            {{/unless}}
            {{/each}}
            </details>
            {{/each}}
            {{/if}}
            {{/each}}
    </section>
</div>
